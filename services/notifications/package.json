  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && cp -r src/generated dist/generated",
    "start": "node dist/index.js",
